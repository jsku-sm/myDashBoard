# 이 예시 파일은 공개해도 되지만, 실제 값을 넣은 secrets.toml은 공개 금지입니다.
[supabase]
url = "https://YOUR_PROJECT.supabase.co"
publishable_key = "sb_publishable_REPLACE_ME"
secret_key = "sb_secret_REPLACE_ME"

[app]
# 처음 교사 계정을 만들 때 사용할 24자 이상의 임의 문자열. 생성 후 빈 문자열로 바꾸세요.
setup_token = "REPLACE_WITH_A_RANDOM_24_CHARACTER_TOKEN"
auth_email_domain = "students.example.com"
teacher_email = "teacher@staff.example.com"
# 학교의 학생 개인정보/클라우드 이용 검토 후에만 true로 바꾸세요.
student_data_approved = false

[ai]
# 처음에는 빈칸 그대로 두세요. 연결하지 않아도 제출 기능은 작동합니다.
openai_api_key = ""
model = "gpt-4.1-mini"
# 외부 AI로 과제 파일을 전달하는 것에 대한 학교의 적법한 처리 기준을 확인한 뒤 변경.
approved = false
max_file_mb = 8
max_pdf_pages = 10
